# AI-CTO Backend Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicto_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/aicto_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet Secret Key for API Key encryption at rest
# IMPORTANT: Generate your own key with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_SECRET_KEY=ZI4lUaSB3LjrE4LrN25nmQvx98H5pc4Q29pprotD6EA=

# NVIDIA NIM LLM Endpoints (Priority Fallback Chain)
NIM_ENDPOINT_1=https://integrate.api.nvidia.com/v1
NIM_API_KEY_1=
NIM_MODEL_1=meta/llama-3.1-70b-instruct

NIM_ENDPOINT_2=https://integrate.api.nvidia.com/v1
NIM_API_KEY_2=
NIM_MODEL_2=mistralai/mixtral-8x22b-instruct-v0.1

NIM_ENDPOINT_3=https://integrate.api.nvidia.com/v1
NIM_API_KEY_3=
NIM_MODEL_3=meta/llama-3.1-8b-instruct

# Sentry (Optional for local dev)
SENTRY_DSN=
